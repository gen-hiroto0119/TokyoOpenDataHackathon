{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eki-awase",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-17",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "RoomObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomObject"] }]
}
